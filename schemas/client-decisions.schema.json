{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/schemas/client-decisions.schema.json",
  "title": "V4 BU Autopilot Client Decisions",
  "description": "clients/<client_id>/decisions.json — somente decisoes explicitas, tomadas de fato, com evidencia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_id",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "decision_id",
        "statement",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "revoked"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
