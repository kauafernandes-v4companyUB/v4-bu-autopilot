{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/schemas/sheet-module-contract.schema.json",
  "title": "Sheet business module contract",
  "description": "clients/<client_id>/sheet-contracts/<module>.json — how ONE client's declared google_sheet source receives a projection from canonical Autopilot state (metrics-sheet, operational-playbook, creative-performance-export). Every target cell/range is explicit here; the engine never hardcodes A1 references. The sheet is a projection, never an authority over canonical state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_id", "module", "source_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "client_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "module": {"enum": ["metrics-sheet", "operational-playbook", "creative-performance-export"]},
    "source_id": {"type": "string", "minLength": 1, "description": "A writable google_sheet source declared in the client's sources.json."},
    "header_expectations": {
      "type": "array",
      "description": "Cells whose current value must match exactly before any patch; a mismatch is CONFLICT_REVIEW_REQUIRED (the sheet structure changed).",
      "items": {"type": "object", "additionalProperties": false, "required": ["range", "value"],
                "properties": {"range": {"$ref": "#/$defs/cell"}, "value": {"type": ["string", "number", "boolean"]}}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["quarter_id", "fields"],
      "properties": {
        "quarter_id": {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
        "fields": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "range"],
          "properties": {
            "field": {"type": "string", "pattern": "^(media\\.[0-9]{4}-(0[1-9]|1[0-2])\\.[a-z][a-z0-9_]*\\.(actual_spend|planned_budget|variance_value|attainment_percent)|objective\\.(current_value|target_value|progress_percent|status)|evidence\\.[A-Za-z0-9_.:-]+\\.value)$"},
            "range": {"$ref": "#/$defs/cell"},
            "label": {"type": "string"},
            "number_format": {"type": "object", "additionalProperties": false, "required": ["type"],
                              "properties": {"type": {"enum": ["NUMBER", "CURRENCY", "PERCENT", "TEXT"]}, "pattern": {"type": "string"}}}
          }}}
      }
    },
    "playbook": {
      "type": "object", "additionalProperties": false, "required": ["template_tab", "target_tab", "sections"],
      "properties": {
        "template_tab": {"type": "string", "minLength": 1},
        "target_tab": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Stable identity of the period's tab (e.g. 'Playbook 2026-10'); never suffixed."},
        "sections": {
          "type": "object", "additionalProperties": false,
          "required": ["CONFIRMED_ACTION", "RECOMMENDATION", "CLIENT_CONFIRMATION_REQUIRED", "DEPENDENCY", "DECISION_REQUIRED"],
          "description": "Bounded 4-column blocks (statement, date, reference, status) on target_tab.",
          "patternProperties": {"^[A-Z_]+$": {"$ref": "#/$defs/block"}}
        }
      }
    },
    "creative": {
      "type": "object", "additionalProperties": false, "required": ["tab", "first_row", "last_row", "columns"],
      "properties": {
        "tab": {"type": "string", "minLength": 1},
        "first_row": {"type": "integer", "minimum": 1},
        "last_row": {"type": "integer", "minimum": 1},
        "columns": {"type": "object", "required": ["row_key"], "additionalProperties": {"type": "string", "pattern": "^[A-Z]{1,3}$"},
                    "description": "export field -> column letter; row_key is the stable identity column."}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"module": {"const": "metrics-sheet"}}}, "then": {"required": ["metrics"]}},
    {"if": {"properties": {"module": {"const": "operational-playbook"}}}, "then": {"required": ["playbook"]}},
    {"if": {"properties": {"module": {"const": "creative-performance-export"}}}, "then": {"required": ["creative"]}}
  ],
  "$defs": {
    "cell": {"type": "string", "pattern": "^'[^']+'![A-Z]{1,3}[0-9]+$", "description": "One cell with explicit quoted tab, e.g. 'Métricas'!B4."},
    "block": {"type": "string", "pattern": "^'[^']+'![A-Z]{1,3}[0-9]+:[A-Z]{1,3}[0-9]+$"}
  }
}
