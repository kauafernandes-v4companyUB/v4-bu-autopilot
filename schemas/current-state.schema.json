{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/schemas/current-state.schema.json",
  "title": "V4 BU Autopilot Current State",
  "description": "clients/<client_id>/current-state.json — fotografia temporal do agora (promote-client-memory secao 9.1). Itens de flags/pending/dependencies sempre carregam statement e evidence_ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_id",
    "updated_at",
    "status",
    "health",
    "goals",
    "metrics",
    "flags",
    "pending",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "health": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "statement",
        "evidence_ids"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  }
}
