{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/schemas/client-sources.schema.json",
  "title": "V4 BU Autopilot Client Sources",
  "description": "clients/<client_id>/sources.json — fontes declaradas do cliente (nunca o conteudo bruto). Entradas google_sheet seguem schemas/google-sheet-source.schema.json; demais tipos mantem forma livre alem dos campos minimos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id",
        "type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "boolean"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "google_sheet"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "https://schemas.v4-bu-autopilot.internal/schemas/google-sheet-source.schema.json"
          }
        }
      ]
    }
  }
}
