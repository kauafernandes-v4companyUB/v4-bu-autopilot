{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/document-winning-creative/output.schema.json",
  "title": "document-winning-creative — creative-performance report",
  "description": "Documentation of ONE creative the operator declared the winner. Structured source of truth; creative-performance.md is rendered from it. Observations, performance facts, replication hypotheses and do-not-generalize items are separate sections and never interchangeable. No ranking, benchmark or loser analysis exists in this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "client_id",
    "creative_id",
    "generated_at",
    "status",
    "winner_status",
    "period",
    "campaign_context",
    "sources_used",
    "asset_metadata",
    "observed_elements",
    "provided_metrics",
    "derived_metrics",
    "performance_summary",
    "replication_hypotheses",
    "do_not_generalize",
    "comparisons",
    "unknowns",
    "operator_notes",
    "memory_promotion_candidates",
    "learning_summary",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill": {
      "const": "document-winning-creative"
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "creative_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "enum": [
        "draft_for_operator_review"
      ]
    },
    "winner_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "declared_by",
        "statement",
        "statistically_compared"
      ],
      "properties": {
        "source": {
          "const": "OPERATOR_DECLARED"
        },
        "declared_by": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "statistically_compared": {
          "const": false
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date",
        "label"
      ],
      "properties": {
        "start_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "campaign_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "metric_row_selection": {
      "$ref": "#/$defs/metric_row_selection",
      "description": "Optional; present exactly when the brief used an operator row rule."
    },
    "post_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "source",
        "metric_row_match_required",
        "opened",
        "note"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "source": {
          "const": "OPERATOR_PROVIDED"
        },
        "metric_row_match_required": {
          "const": false
        },
        "opened": {
          "const": false
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path",
          "kind",
          "used_for"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S-[0-9]{2,}$"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "creative_asset",
              "metric_source",
              "comparative_evidence",
              "client_identity"
            ]
          },
          "used_for": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asset_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "observed_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "provided_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provided_metric"
      }
    },
    "derived_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derived_metric"
      }
    },
    "performance_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "learning_class",
          "metric_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PF-[0-9]{2,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "learning_class": {
            "const": "PERFORMANCE_FACT"
          },
          "metric_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[MD]-[0-9]{2,}$"
            }
          },
          "source_trace": {
            "type": "array",
            "description": "Required (and checked) when a cited metric was read from a selected export row.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric_ref",
                "source_id",
                "source_row",
                "source_column",
                "result_type"
              ],
              "properties": {
                "metric_ref": {
                  "type": "string",
                  "pattern": "^M-[0-9]{2,}$"
                },
                "source_id": {
                  "type": "string"
                },
                "source_row": {
                  "type": "integer"
                },
                "source_column": {
                  "type": "string"
                },
                "result_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "replication_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "learning_class",
          "based_on_elements",
          "test_suggestion",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H-[0-9]{2,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "learning_class": {
            "const": "REPLICATION_HYPOTHESIS"
          },
          "based_on_elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "related_metric_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[MD]-[0-9]{2,}$"
            }
          },
          "test_suggestion": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium"
            ],
            "description": "Never high: one winner without comparison cannot establish a pattern."
          }
        }
      }
    },
    "do_not_generalize": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "learning_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NG-[0-9]{2,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "learning_class": {
            "const": "DO_NOT_GENERALIZE"
          },
          "related_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "description": "Empty unless the operator provided comparative_evidence; each item cites it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[0-9]{2,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "status",
          "reason"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "UNKNOWN",
              "NOT_AVAILABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operator_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OP-[0-9]{2,}$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "memory_promotion_candidates": {
      "type": "array",
      "description": "Suggestions only — promotion happens later via promote-client-memory. Hypotheses are never candidates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "note"
        ],
        "properties": {
          "kind": {
            "enum": [
              "PERFORMANCE_FACT",
              "OBSERVED_PATTERN",
              "OPERATOR_DECISION"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "learning_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OBSERVED_PATTERN",
        "PERFORMANCE_FACT",
        "REPLICATION_HYPOTHESIS",
        "DO_NOT_GENERALIZE"
      ],
      "properties": {
        "OBSERVED_PATTERN": {
          "type": "integer",
          "minimum": 0
        },
        "PERFORMANCE_FACT": {
          "type": "integer",
          "minimum": 0
        },
        "REPLICATION_HYPOTHESIS": {
          "type": "integer",
          "minimum": 0
        },
        "DO_NOT_GENERALIZE": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "metric_row_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "source",
        "source_id",
        "source_path",
        "column",
        "result_type_column",
        "ad_name_column",
        "ad_set_name_column",
        "campaign_name_column",
        "selected_row",
        "candidate_count",
        "excluded_rows",
        "tied",
        "tied_rows",
        "tie_resolution",
        "same_ad_name_rows",
        "aggregated",
        "result_types_found",
        "next_highest_value",
        "notes"
      ],
      "properties": {
        "rule": {
          "enum": [
            "MAX_RESULTS"
          ]
        },
        "source": {
          "const": "OPERATOR_RULE"
        },
        "source_id": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "result_type_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "ad_name_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "ad_set_name_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "campaign_name_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_row": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "row_number",
            "ad_name",
            "ad_set_name",
            "campaign_name",
            "result"
          ],
          "properties": {
            "row_number": {
              "type": "integer",
              "description": "Line in the export file where the record ends (header = 1)."
            },
            "ad_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "ad_set_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "campaign_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source_metric_name",
                "source_result_type",
                "normalized_label",
                "normalization_confidence"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "source_metric_name": {
                  "type": "string"
                },
                "source_result_type": {
                  "type": "string",
                  "description": "Original identifier from the export, or UNKNOWN."
                },
                "normalized_label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Optional friendly label; never replaces source_result_type."
                },
                "normalization_confidence": {
                  "enum": [
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                    null
                  ]
                }
              }
            }
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row_number",
              "reason"
            ],
            "properties": {
              "row_number": {
                "type": "integer"
              },
              "reason": {
                "enum": [
                  "EMPTY_OR_INVALID_RESULT",
                  "SUMMARY_ROW_WITHOUT_AD_NAME"
                ]
              }
            }
          }
        },
        "tied": {
          "type": "boolean"
        },
        "tied_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "tie_resolution": {
          "enum": [
            "OPERATOR_CONFIRMED",
            null
          ]
        },
        "same_ad_name_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Other rows with the selected ad's name — listed, never summed."
        },
        "aggregated": {
          "const": false
        },
        "result_types_found": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_highest_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "source_id",
        "path",
        "kind",
        "status",
        "description",
        "mime_type",
        "bytes",
        "sha256",
        "width",
        "height",
        "orientation",
        "aspect_ratio",
        "dimensions_basis",
        "duration_seconds",
        "duration_basis"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^A-[0-9]{2,}$"
        },
        "source_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "pdf",
            "text",
            "other"
          ]
        },
        "status": {
          "enum": [
            "loaded",
            "missing",
            "rejected_other_client"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square",
            null
          ]
        },
        "aspect_ratio": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions_basis": {
          "enum": [
            "file_header",
            "operator_provided",
            "ffprobe",
            "not_available"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "duration_basis": {
          "enum": [
            "operator_provided",
            "ffprobe",
            "not_available"
          ]
        },
        "technical_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe",
            "fields"
          ],
          "description": "Video assets only (1.2.0+). Each field records its source; an operator value is never overwritten by ffprobe.",
          "properties": {
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool",
                "status",
                "tool_version",
                "probed_sha256",
                "values"
              ],
              "properties": {
                "tool": {
                  "const": "ffprobe"
                },
                "status": {
                  "enum": [
                    "OK",
                    "FFPROBE_UNAVAILABLE",
                    "FFPROBE_FAILED"
                  ]
                },
                "tool_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "probed_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "sha256 of the file ffprobe measured; binds the recorded answer to the asset."
                },
                "values": {
                  "type": "object",
                  "description": "ffprobe's parsed answer, kept so a replica without ffprobe can re-derive the fields."
                }
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "duration_seconds",
                "width",
                "height",
                "frame_rate",
                "video_codec",
                "audio_codec",
                "audio_channels",
                "audio_sample_rate",
                "orientation",
                "aspect_ratio"
              ],
              "properties": {
                "duration_seconds": {
                  "$ref": "#/$defs/technical_field"
                },
                "width": {
                  "$ref": "#/$defs/technical_field"
                },
                "height": {
                  "$ref": "#/$defs/technical_field"
                },
                "frame_rate": {
                  "$ref": "#/$defs/technical_field"
                },
                "video_codec": {
                  "$ref": "#/$defs/technical_field"
                },
                "audio_codec": {
                  "$ref": "#/$defs/technical_field"
                },
                "audio_channels": {
                  "$ref": "#/$defs/technical_field"
                },
                "audio_sample_rate": {
                  "$ref": "#/$defs/technical_field"
                },
                "orientation": {
                  "$ref": "#/$defs/derived_field"
                },
                "aspect_ratio": {
                  "$ref": "#/$defs/derived_field"
                }
              }
            }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "dimension",
        "status",
        "description",
        "asset_id",
        "location",
        "learning_class"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "pattern": "^E-[0-9]{2,}$"
        },
        "dimension": {
          "enum": [
            "format",
            "piece_type",
            "orientation",
            "duration",
            "headline",
            "main_text",
            "cta",
            "offer",
            "product_or_service",
            "benefit",
            "promise",
            "proof",
            "urgency",
            "visual_elements",
            "hierarchy",
            "human_presence",
            "product_presence",
            "branding",
            "style",
            "narrative_structure",
            "hook_first_frame",
            "closing",
            "destination"
          ]
        },
        "status": {
          "enum": [
            "OBSERVED",
            "NOT_PRESENT",
            "NOT_OBSERVABLE",
            "NOT_APPLICABLE"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "What is objectively in the creative — never why it worked."
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where in the asset (e.g. 'bloco superior', '0–3s', 'página 2')."
        },
        "learning_class": {
          "const": "OBSERVED_PATTERN"
        }
      }
    },
    "provided_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "metric_key",
        "canonical_metric",
        "label",
        "value",
        "unit",
        "status",
        "classification",
        "provenance",
        "note"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^M-[0-9]{2,}$"
        },
        "metric_key": {
          "type": "string"
        },
        "canonical_metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PROVIDED",
            "NOT_AVAILABLE"
          ]
        },
        "classification": {
          "const": "METRIC"
        },
        "provenance": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_row": {
          "type": "integer",
          "description": "Present only for metrics read from a selected export row."
        },
        "source_column": {
          "type": "string"
        },
        "result_type": {
          "type": "string",
          "description": "Original result-type identifier of the export (or UNKNOWN) — never replaced by a friendly label."
        }
