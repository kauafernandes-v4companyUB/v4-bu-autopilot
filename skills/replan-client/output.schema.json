{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/replan-client/output.schema.json",
  "title": "Replan Client Output",
  "description": "INTELLIGENCE, read-only. Produces a replanning proposal — actions are proposals, not tasks (generate-tasks handles that conversion, ACTION category, preview-only). Never mutates Quarter SMART/target/baseline/planned_budget (operation/quarter-rules.md) — a budget change is a recommendation here, never applied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "replanning_id", "client_id", "quarter_id", "generated_at", "status", "context_pack_ref", "diagnosis_ref", "gaps_ref", "priorities_ref", "objective_alignment", "what_changed", "what_remains", "strategic_direction", "workstreams", "missing_data", "warnings"],
  "properties": {
    "schema_version": {"type": "string"},
    "skill": {"const": "replan-client"},
    "replanning_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "quarter_id": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"}, {"type": "null"}]},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "failed"]},
    "context_pack_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "diagnosis_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "gaps_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "priorities_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "objective_alignment": {"type": "string", "minLength": 1, "description": "How this replanning relates to the Quarter's existing SMART objective — never a redefinition of it."},
    "what_changed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "what_remains": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "strategic_direction": {"type": "string", "minLength": 1},
    "workstreams": {"type": "array", "items": {"$ref": "#/$defs/workstream"}},
    "missing_data": {"type": "array", "items": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/context-pack.schema.json#/$defs/missingDataItem"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "workstream": {
      "type": "object", "additionalProperties": false,
      "required": ["workstream_id", "priority_id", "objective", "rationale", "evidence_ids", "actions", "success_signal", "dependencies", "risks", "do_not_do", "confidence"],
      "properties": {
        "workstream_id": {"type": "string", "minLength": 1},
        "priority_id": {"type": "string", "minLength": 1, "description": "Must resolve in the referenced identify-priorities output."},
        "objective": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/actionProposal"}},
        "success_signal": {"type": "string", "minLength": 1, "description": "What observable evidence would show this workstream worked — not a guaranteed outcome."},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "do_not_do": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "actionProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "statement", "reason", "expected_effect", "evidence_ids", "prerequisite", "deadline_requirement", "external_action_required", "irreversible", "confidence"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expected_effect": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prerequisite": {"type": ["string", "null"]},
        "deadline_requirement": {
          "description": "explicit: a real deadline already exists (evidence-backed). derived_from_existing_commitment: inherits an already-committed date. needs_operator_decision: a deadline is needed but none exists yet — never invented. none: this action has no due date by nature.",
          "enum": ["explicit", "derived_from_existing_commitment", "needs_operator_decision", "none"]
        },
        "deadline_source": {"type": ["string", "null"], "description": "evidence_id or reference backing deadline_requirement when explicit/derived_from_existing_commitment; null otherwise."},
        "external_action_required": {"type": "boolean"},
        "irreversible": {"type": "boolean"},
        "confidence": {"enum": ["low", "medium", "high"]}
      },
      "allOf": [
        {
          "if": {"properties": {"deadline_requirement": {"enum": ["explicit", "derived_from_existing_commitment"]}}, "required": ["deadline_requirement"]},
          "then": {"required": ["deadline_source"], "properties": {"deadline_source": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
