{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/read-whatsapp/output.schema.json",
  "title": "Read WhatsApp Output",
  "description": "Contrato de output da skill read-whatsapp. Ver skills/read-whatsapp/SKILL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "version", "client_id", "generated_at", "status", "source", "qualification", "conversation_context", "participants", "data", "evidence", "missing_data", "warnings"],
  "allOf": [
    {"if": {"properties": {"qualification": {"properties": {"source_compatible": {"const": false}}, "required": ["source_compatible"]}}, "required": ["qualification"]}, "then": {"properties": {"status": {"const": "failed"}, "data": {"maxProperties": 0}}}},
    {"if": {"properties": {"conversation_context": {"properties": {"client_found": {"const": false}}, "required": ["client_found"]}}, "required": ["conversation_context"]}, "then": {"properties": {"status": {"const": "failed"}, "data": {"maxProperties": 0}}}},
    {"if": {"properties": {"status": {"const": "success"}}, "required": ["status"]}, "then": {"properties": {"qualification": {"properties": {"source_compatible": {"const": true}}, "required": ["source_compatible"]}, "conversation_context": {"properties": {"client_found": {"const": true}}, "required": ["client_found"]}}}}
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "skill": {"const": "read-whatsapp"},
    "version": {"const": "1.0.0"},
    "client_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "description": "Timestamp real da execucao, UTC RFC3339; nunca inferido da conversa."},
    "status": {"type": "string", "enum": ["success", "partial", "failed"]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["reference"],
      "properties": {"source_id": {"type": ["string", "null"]}, "reference": {"type": "string", "minLength": 1}, "client_selector_used": {"type": ["string", "null"]}}
    },
    "qualification": {
      "type": "object", "additionalProperties": false, "required": ["source_kind", "source_compatible", "confidence"],
      "properties": {
        "source_kind": {"type": "string", "enum": ["whatsapp_export", "whatsapp_chat_export", "client_whatsapp_export", "account_gt_transcript", "client_checkin_transcript", "account_handoff", "client_handoff", "bi_dashboard", "crm_export", "task_export", "task_list", "unrelated_document", "unknown"]},
        "source_compatible": {"type": "boolean"}, "confidence": {"$ref": "#/$defs/confidence"}, "suggested_skill": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"source_kind": {"enum": ["whatsapp_export", "whatsapp_chat_export", "client_whatsapp_export"]}}, "required": ["source_kind"]}, "then": {"properties": {"source_compatible": {"const": true}}}, "else": {"properties": {"source_compatible": {"const": false}}}}]
    },
    "conversation_context": {
      "type": "object", "additionalProperties": false, "required": ["client_found", "conversation_start_date", "conversation_end_date", "start_reference", "end_reference", "confidence"],
      "properties": {"client_found": {"type": "boolean"}, "conversation_start_date": {"type": ["string", "null"], "format": "date"}, "conversation_end_date": {"type": ["string", "null"], "format": "date"}, "start_reference": {"type": ["string", "null"]}, "end_reference": {"type": ["string", "null"]}, "confidence": {"$ref": "#/$defs/confidence"}, "method": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}
    },
    "participants": {"type": "array", "items": {"$ref": "#/$defs/participant"}},
    "data": {"type": "object", "additionalProperties": false, "properties": {
      "client_requests": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "client_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision_item"}}, "commitments": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "pending": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "campaign_feedback": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "commercial_feedback": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "performance_mentions": {"type": "array", "items": {"$ref": "#/$defs/metric_item"}}, "risks": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "ideas": {"type": "array", "items": {"$ref": "#/$defs/conversation_item"}}, "references": {"type": "array", "items": {"$ref": "#/$defs/reference_item"}}, "unresolved_questions": {"type": "array", "items": {"$ref": "#/$defs/question_item"}}
    }},
    "evidence": {"type": "array", "items": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/evidence.schema.json"}},
    "missing_data": {"type": "array", "items": {"$ref": "#/$defs/missing_data"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "semantic_type": {"type": "string", "enum": ["fact", "metric", "decision", "hypothesis", "request", "commitment", "pending", "risk", "idea", "dependency"]},
    "participant": {"type": "object", "additionalProperties": false, "required": ["participant_name", "participant_role", "role_confidence", "role_basis"], "properties": {"participant_name": {"type": "string", "minLength": 1}, "participant_role": {"type": "string", "enum": ["client", "account", "traffic_manager", "internal_team", "external_partner", "unknown"]}, "role_confidence": {"$ref": "#/$defs/confidence"}, "role_basis": {"type": ["string", "null"]}}},
    "message_metadata": {"type": "object", "additionalProperties": false, "required": ["participant_name", "participant_role", "communication_direction", "message_reference", "reply_reference", "reply_participant_name", "message_relationship", "quoted_context", "message_date", "local_time_reference"], "properties": {"participant_name": {"type": ["string", "null"]}, "participant_role": {"type": ["string", "null"], "enum": ["client", "account", "traffic_manager", "internal_team", "external_partner", "unknown", null]}, "communication_direction": {"type": "string", "enum": ["direct_client_statement", "internal_statement", "external_statement", "quoted_statement", "forwarded_statement", "unknown"]}, "message_reference": {"type": ["string", "null"]}, "reply_reference": {"type": ["string", "null"]}, "reply_participant_name": {"type": ["string", "null"]}, "message_relationship": {"type": ["string", "null"], "enum": ["reply", "quote", "forward", null]}, "quoted_context": {"type": ["string", "null"]}, "message_date": {"type": ["string", "null"], "format": "date"}, "local_time_reference": {"type": ["string", "null"]}}},
    "conversation_item": {"type": "object", "additionalProperties": false, "required": ["statement", "type", "confidence", "evidence_ids", "message"], "properties": {"statement": {"type": "string", "minLength": 1}, "type": {"$ref": "#/$defs/semantic_type"}, "confidence": {"$ref": "#/$defs/confidence"}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "message": {"$ref": "#/$defs/message_metadata"}, "value": {"type": ["string", "number", "integer", "null"]}, "unit": {"type": ["string", "null"]}, "reported_in_conversation": {"type": "boolean"}, "supersedes_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "superseded_by_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "notes": {"type": ["string", "null"]}}},
    "decision_item": {"allOf": [{"$ref": "#/$defs/conversation_item"}, {"properties": {"type": {"const": "decision"}}}]},
    "metric_item": {"allOf": [{"$ref": "#/$defs/conversation_item"}, {"required": ["reported_in_conversation"], "properties": {"type": {"const": "metric"}, "reported_in_conversation": {"const": true}, "value": {"type": ["string", "number", "integer", "null"]}, "unit": {"type": ["string", "null"]}}}]},
    "reference_item": {"type": "object", "additionalProperties": false, "required": ["reference", "opened", "evidence_ids"], "properties": {"reference": {"type": "string", "minLength": 1}, "opened": {"const": false}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "message": {"$ref": "#/$defs/message_metadata"}}},
    "question_item": {"type": "object", "additionalProperties": false, "required": ["statement", "evidence_ids", "message"], "properties": {"statement": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "message": {"$ref": "#/$defs/message_metadata"}}},
    "missing_data": {"type": "object", "additionalProperties": false, "required": ["field", "impact", "blocking"], "properties": {"field": {"type": "string", "minLength": 1}, "expected_source": {"type": ["string", "null"]}, "impact": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}}}
  }
}
