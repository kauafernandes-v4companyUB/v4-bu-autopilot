{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/generate-tasks/output.schema.json",
  "title": "Generate Tasks Output",
  "description": "ACTION, preview-only in this MVP (mode is always 'preview' — this skill never writes tasks.json itself; see operation/task-rules.md and operation/replanning-rules.md). Produces task_proposals compatible with manage-task-ledger's create_task operation shape, classified by readiness so an operator can see READY / NEEDS_SCHEDULING / NEEDS_DECISION / DEPENDENCIES / EXTERNAL at a glance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "mode", "proposal_set_id", "client_id", "quarter_id", "generated_at", "status", "replanning_ref", "audit_ref", "task_proposals", "summary", "missing_data", "warnings"],
  "properties": {
    "schema_version": {"type": "string"},
    "skill": {"const": "generate-tasks"},
    "mode": {"const": "preview"},
    "proposal_set_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "quarter_id": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"}, {"type": "null"}]},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "failed"]},
    "replanning_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "audit_ref": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/artifact-ref.schema.json"},
    "task_proposals": {"type": "array", "items": {"$ref": "#/$defs/taskProposal"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["ready", "needs_scheduling", "needs_decision", "dependency", "external", "not_task"],
      "properties": {
        "ready": {"type": "integer", "minimum": 0},
        "needs_scheduling": {"type": "integer", "minimum": 0},
        "needs_decision": {"type": "integer", "minimum": 0},
        "dependency": {"type": "integer", "minimum": 0},
        "external": {"type": "integer", "minimum": 0},
        "not_task": {"type": "integer", "minimum": 0}
      }
    },
    "missing_data": {"type": "array", "items": {"$ref": "https://schemas.v4-bu-autopilot.internal/schemas/context-pack.schema.json#/$defs/missingDataItem"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "taskProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "action_id", "classification", "readiness", "title", "description", "raised_at", "due_at", "quarter_id", "origin", "evidence_ids", "manage_task_operation", "reason_if_blocked"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1, "description": "The replan-client action_proposal.action_id this was derived from."},
        "classification": {"enum": ["task_candidate", "decision_required", "external_action", "information_request", "monitoring_item", "not_task"]},
        "readiness": {"enum": ["ready", "needs_scheduling", "needs_decision", "dependency", "external", "not_task"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "raised_at": {"type": "string", "format": "date"},
        "due_at": {"type": ["string", "null"], "format": "date"},
        "quarter_id": {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "evidence_ids"],
          "properties": {
            "type": {"enum": ["whatsapp", "account_gt", "check_in", "replanning", "manual", "other"]},
            "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "manage_task_operation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/manageTaskOperation"}]},
        "reason_if_blocked": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"readiness": {"const": "ready"}}, "required": ["readiness"]},
          "then": {"required": ["manage_task_operation"], "properties": {"manage_task_operation": {"type": "object"}, "reason_if_blocked": {"type": "null"}}}
        },
        {
          "if": {"properties": {"readiness": {"not": {"const": "ready"}}}, "required": ["readiness"]},
          "then": {"properties": {"manage_task_operation": {"type": "null"}}, "required": ["reason_if_blocked"], "properties": {"reason_if_blocked": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "manageTaskOperation": {
      "description": "Shape compatible with manage-task-ledger's create_task operation (skills/manage-task-ledger/SKILL.md section 6) minus client_id, which manage-task-ledger always fills from execution context, never from an upstream proposal.",
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "type", "task_id", "title", "description", "raised_at", "due_at", "quarter_id", "origin", "evidence_ids"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "type": {"const": "create_task"},
        "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "raised_at": {"type": "string", "format": "date"},
        "due_at": {"type": "string", "format": "date"},
        "quarter_id": {"type": "string", "pattern": "^[0-9]{4}-Q[1-4]$"},
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "evidence_ids"],
          "properties": {
            "type": {"enum": ["whatsapp", "account_gt", "check_in", "replanning", "manual", "other"]},
            "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
