{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/read-bi/output.schema.json",
  "title": "Read BI Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "client_id", "generated_at", "status", "source", "report_period", "filters", "dimensions", "metric_observations", "result_observations", "monitoring_candidates", "conflicts", "missing_data", "warnings", "validation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {"const": "read-bi"},
    "client_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Entrada explícita; nunca inferida do arquivo."},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "error", "conflict"]},
    "source": {"$ref": "#/$defs/source"},
    "report_period": {"$ref": "#/$defs/period"},
    "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "metric_observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "result_observations": {"type": "array", "items": {"$ref": "#/$defs/resultObservation"}},
    "monitoring_candidates": {"type": "array", "items": {"$ref": "#/$defs/monitoringCandidate"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
    "missing_data": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["source_readable", "extraction_valid", "report_period_valid", "metrics_valid", "conflicts_resolved", "output_valid", "errors"], "properties": {"source_readable": {"type": ["boolean", "null"]}, "extraction_valid": {"type": ["boolean", "null"]}, "report_period_valid": {"type": ["boolean", "null"]}, "metrics_valid": {"type": ["boolean", "null"]}, "conflicts_resolved": {"type": ["boolean", "null"]}, "output_valid": {"type": ["boolean", "null"]}, "errors": {"type": "array", "items": {"$ref": "#/$defs/notice"}}}}
  },
  "$defs": {
    "date": {"type": ["string", "null"], "format": "date"},
    "notice": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["type", "path", "filename", "file_sha256", "observed_at", "source_date", "extractor", "page_count", "row_count"], "properties": {"type": {"enum": ["pdf", "csv"]}, "path": {"type": "string", "minLength": 1}, "filename": {"type": "string", "minLength": 1}, "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "observed_at": {"type": "string", "format": "date-time"}, "source_date": {"$ref": "#/$defs/date"}, "extractor": {"type": "string", "minLength": 1, "description": "CSV usa parser mecânico. PDF semântico deve registrar codex-visual ou pdf-render+codex-visual; pdftotext, se houver, é apenas hint."}, "page_count": {"type": ["integer", "null"], "minimum": 0}, "row_count": {"type": ["integer", "null"], "minimum": 0}}},
    "period": {"type": "object", "additionalProperties": false, "required": ["start_date", "end_date", "basis", "source_text"], "properties": {"start_date": {"$ref": "#/$defs/date"}, "end_date": {"$ref": "#/$defs/date"}, "basis": {"enum": ["explicit_range", "month_to_date", "full_month", "quarter_to_date", "single_date", "snapshot", "unknown"]}, "source_text": {"type": ["string", "null"]}, "age_days": {"type": ["integer", "null"], "minimum": 0}}},
    "sourceRef": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "page", "excerpt"], "properties": {"type": {"const": "pdf"}, "page": {"type": "integer", "minimum": 1}, "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}}}, {"type": "object", "additionalProperties": false, "required": ["type", "row", "column", "raw_cell"], "properties": {"type": {"const": "csv"}, "row": {"type": "integer", "minimum": 2}, "column": {"type": "string", "minLength": 1}, "raw_cell": {"type": "string"}}}]},
    "filter": {"type": "object", "additionalProperties": false, "required": ["name", "value", "source_ref"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["name", "value", "source_ref"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["observation_id", "metric_key", "canonical_metric", "label", "raw_value", "value", "unit", "channel", "period", "basis", "source_refs", "confidence", "derived", "formula", "source_observation_ids"], "properties": {"observation_id": {"type": "string", "pattern": "^biobs-[a-f0-9]{16}$"}, "metric_key": {"type": "string", "minLength": 1}, "canonical_metric": {"type": ["string", "null"], "enum": ["spend", "impressions", "reach", "clicks", "leads", "conversions", "sales", "revenue", "cpm", "cpc", "ctr", "cpl", "cpa", "conversion_rate", "roas", null]}, "label": {"type": "string", "minLength": 1}, "raw_value": {"type": "string"}, "value": {"type": ["number", "null"]}, "unit": {"enum": ["count", "brl", "percent", "ratio", "currency_other", "seconds", "days", "other", "unknown"]}, "channel": {"enum": ["meta_ads", "google_ads", "all", "other", null]}, "period": {"$ref": "#/$defs/period"}, "basis": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}, "confidence": {"enum": ["high", "medium", "low"]}, "derived": {"type": "boolean"}, "formula": {"type": ["string", "null"]}, "source_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^biobs-[a-f0-9]{16}$"}}}, "allOf": [{"if": {"properties": {"derived": {"const": true}}, "required": ["derived"]}, "then": {"properties": {"formula": {"type": "string", "minLength": 1}, "source_observation_ids": {"minItems": 2}}}, "else": {"properties": {"formula": {"type": "null"}, "source_observation_ids": {"maxItems": 0}}}}]},
    "resultObservation": {"type": "object", "additionalProperties": false, "required": ["observation_id", "role"], "properties": {"observation_id": {"type": "string", "pattern": "^biobs-[a-f0-9]{16}$"}, "role": {"enum": ["media_result", "funnel_result", "commercial_result", "operational_result", "other"]}}},
    "monitoringCandidate": {"type": "object", "additionalProperties": false, "required": ["candidate_type", "month", "channel", "actual_spend", "basis", "as_of_date", "eligible", "reason", "observation_ids"], "properties": {"candidate_type": {"const": "media_actual"}, "month": {"type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}, "channel": {"enum": ["meta_ads", "google_ads", "all", "other", null]}, "actual_spend": {"type": ["number", "null"]}, "basis": {"enum": ["month_to_date", "full_month", "period_total", "unknown"]}, "as_of_date": {"$ref": "#/$defs/date"}, "eligible": {"type": "boolean"}, "reason": {"type": ["string", "null"]}, "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^biobs-[a-f0-9]{16}$"}}}, "allOf": [{"if": {"properties": {"eligible": {"const": true}}, "required": ["eligible"]}, "then": {"properties": {"month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}, "channel": {"enum": ["meta_ads", "google_ads", "all", "other"]}, "actual_spend": {"type": "number"}, "basis": {"enum": ["month_to_date", "full_month"]}, "reason": {"type": "null"}}}, "else": {"properties": {"reason": {"type": "string", "minLength": 1}}}}]}
  }
}
