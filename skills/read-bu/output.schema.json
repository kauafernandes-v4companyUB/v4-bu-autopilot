{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.v4-bu-autopilot.internal/skills/read-bu/output.schema.json",
  "title": "Read BU Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "generated_at",
    "status",
    "source_kind",
    "source_compatible",
    "bu",
    "clients",
    "evidence",
    "missing_data",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "skill": {
      "const": "read-bu"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "source_kind": {
      "description": "Classificação estrutural da fonte, produzida pela etapa obrigatória de Source Qualification (ver SKILL.md secao 8). 'client_portfolio_index' e o unico valor compativel com extracao de clientes.",
      "type": "string",
      "enum": [
        "client_portfolio_index",
        "account_handoff",
        "strategic_documentation",
        "client_report",
        "transcript",
        "conversation",
        "briefing",
        "other_narrative",
        "unknown"
      ]
    },
    "source_compatible": {
      "description": "true somente quando source_kind = client_portfolio_index. Quando false, a extracao semantica de clientes nao deve ser realizada e status deve ser 'failed'.",
      "type": "boolean"
    },
    "suggested_skill": {
      "description": "Preenchido somente quando source_compatible = false. Sugestao textual de qual categoria/skill deveria tratar esta fonte (sem executa-la). null quando source_compatible = true ou quando nenhuma sugestao segura pode ser feita.",
      "type": ["string", "null"]
    },
    "bu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_date": {
          "type": ["string", "null"]
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_id",
          "display_name",
          "status",
          "flag",
          "sources",
          "raw"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "object",
            "required": ["raw", "normalized"],
            "properties": {
              "raw": {
                "type": ["string", "null"]
              },
              "normalized": {
                "type": "string",
                "enum": [
                  "ongoing",
                  "offboarding",
                  "unknown"
                ]
              }
            }
          },
          "flag": {
            "type": "object",
            "required": ["raw", "normalized"],
            "properties": {
              "raw": {
                "type": ["string", "null"]
              },
              "normalized": {
                "type": "string",
                "enum": [
                  "green",
                  "yellow",
                  "red",
                  "unknown"
                ]
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "reference"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "whatsapp_group",
                    "documentation",
                    "spreadsheet",
                    "contract",
                    "attachment",
                    "crm",
                    "operational_routine",
                    "unknown"
                  ]
                },
                "label": {
                  "type": ["string", "null"]
                },
                "reference": {
                  "type": "string"
                }
              }
            }
          },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "global_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": ["string", "null"]
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.v4-bu-autopilot.internal/schemas/evidence.schema.json"
      }
    },
    "missing_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "impact", "blocking"],
        "properties": {
          "client_id": {
            "type": ["string", "null"]
          },
          "field": {
            "type": "string"
          },
          "expected_source": {
            "type": ["string", "null"]
          },
          "impact": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
