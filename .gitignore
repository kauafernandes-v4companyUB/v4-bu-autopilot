# ==========================================
# V4 BU AUTOPILOT
# Arquivos privados e temporários
# ==========================================

# Credenciais
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# Conteúdo privado de clientes
private/

# Contexto temporário gerado pelas skills
context/generated/

# Memória canônica real de clientes NUNCA vive no engine público.
# Ela vive em $V4_BU_WORKSPACE_ROOT (repo privado separado).
# Se clients/ aparecer aqui de novo (ex.: alguém rodando skills sem
# configurar o workspace), ele fica ignorado — nunca commitado.
# Ver docs/security-model.md e scripts/lib/workspace.py.
clients/

# Outputs operacionais não curados (equivalente local a outputs/ do
# workspace privado, quando skills rodam sem workspace configurado).
/outputs/*
!/outputs/.gitkeep

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude local
.claude/settings.local.json

# Temporários
*.tmp
*.log
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
